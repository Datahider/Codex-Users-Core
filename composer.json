{
    "name": "ioannidis/codex-runtime",
    "description": "Transport-agnostic runtime core for Codex-based operators",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "losthost/background-process": "^1.1"
    },
    "scripts": {
        "smoke": [
            "php smoke/default-config-resolution.php",
            "php smoke/minimal-config-surface.php",
            "php smoke/runtime-storage-layout.php",
            "php smoke/doctor-ready-config.php"
        ]
    },
    "autoload": {
        "psr-4": {
            "CodexRuntime\\": "src/"
        }
    }
}
