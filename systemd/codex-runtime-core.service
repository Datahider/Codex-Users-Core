[Unit]
Description=Codex Runtime Core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=web
WorkingDirectory=/home/web/Документы/codex-runtime
Environment=HOME=/home/web
Environment=COMPOSER_HOME=/home/web/.composer
Environment=PATH=/home/web/Документы/codex-runtime/bin/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/env php /home/web/Документы/codex-runtime/bin/run-core.php /home/web/Документы/codex-runtime/config/config.php
Restart=always
RestartSec=2
KillMode=control-group

[Install]
WantedBy=multi-user.target
